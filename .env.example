# Copiá este archivo a .env y completá los valores.
# El .env REAL nunca se commitea (está en .gitignore) y es lo que protege el
# hook guard del ejercicio E3.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reports

